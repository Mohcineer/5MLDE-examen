# Copier vers .env (non versionné) et REMPLACER les mots de passe. Aucun secret dans ce fichier.
# --- compose.yml (mots de passe obligatoires) ---
POSTGRES_PASSWORD=CHANGEME
API_DB_PASSWORD=CHANGEME
GRAFANA_DB_PASSWORD=CHANGEME
GRAFANA_ADMIN_PASSWORD=CHANGEME
# Ressources de l'API (comparer des configurations : voir SYNTHESE.md)
API_CPUS=1.0
API_MEM_LIMIT=768m
API_WORKERS=1

# --- Scripts exécutés sur le poste (flows, démos, registre) ---
MLFLOW_TRACKING_URI=http://localhost:5000
PREFECT_API_URL=http://localhost:4200/api
# Base de traçabilité (même mot de passe que API_DB_PASSWORD). Repli sans Docker : sqlite:///local/bikeshare.db
DATABASE_URL=postgresql://api_writer:CHANGEME@localhost:5432/bikeshare
# Destination des alertes : récepteur HTTP de test (scripts/alert_receiver.py) ou webhook Teams
ALERT_WEBHOOK_URL=http://host.docker.internal:8765/alert
# URL du webhook Teams : saisie masquée par flows/setup_alerts.py --channel teams, jamais écrite ici.
